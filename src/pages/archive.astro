---
import Base from '../layouts/Base.astro';
import { loadAllIssues, displayDate, displayDateCn, weekdayOf } from '../lib/load';

const base = import.meta.env.BASE_URL;
const issues = loadAllIssues();

const years = [...new Set(issues.map((i) => i.date.slice(0, 4)))].sort().reverse();
const byYear = years.map((year) => ({
  year,
  items: issues
    .map((issue, i) => ({ issue, no: issues.length - i }))
    .filter(({ issue }) => issue.date.startsWith(year)),
}));

const earliest = issues[issues.length - 1].date;
const latest = issues[0].date;
---

<Base title="归档 · 开源雷达" description="全部期次的 GitHub 热点日报，按日期倒序。">
  <header class="cover">
    <div class="cover-main">
      <p class="cover-kicker">全部期次</p>
      <h1>归档</h1>
      <p class="cover-lede">
        每一期都保留独立永久链接。日报由同一套评分规则生成，条目与评分在构建时固化，不随后续数据变化。
      </p>
    </div>
    <aside class="cover-meta">
      <dl>
        <div><dt>期数</dt><dd>{issues.length}</dd></div>
        <div><dt>起始</dt><dd>{displayDate(earliest)}</dd></div>
        <div><dt>最近</dt><dd>{displayDate(latest)}</dd></div>
      </dl>
    </aside>
  </header>

  {
    byYear.map(({ year, items }) => (
      <section>
        <div class="toc-head">
          <h2>{year}</h2>
          <span>{items.length} 期</span>
        </div>
        {items.map(({ issue, no }) => (
          <a class="toc-row" href={`${base}posts/${issue.date}/`}>
            <span class="toc-no">第 {String(no).padStart(2, '0')} 期</span>
            <span class="toc-title">{displayDateCn(issue.date)}</span>
            <span class="toc-date">{weekdayOf(issue.date)}</span>
            <span class="toc-lead" aria-hidden="true" />
            <span class="toc-figs">{issue.stats.selected} 个项目</span>
          </a>
        ))}
      </section>
    ))
  }
</Base>

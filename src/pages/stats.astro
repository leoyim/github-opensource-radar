---
import Base from '../layouts/Base.astro';
import { loadAllIssues, displayDate } from '../lib/load';
import { num } from '../lib/format';

const base = import.meta.env.BASE_URL;
const issues = loadAllIssues();
const items = issues.flatMap((i) => i.categories.flatMap((c) => c.items));

/* 评分分布 */
const ratingBuckets = Array.from({ length: 9 }, (_, i) => 5 - i * 0.5);
const ratingCount = new Map<number, number>();
items.forEach((it) => ratingCount.set(it.rating, (ratingCount.get(it.rating) ?? 0) + 1));
const ratingMax = Math.max(1, ...ratingCount.values());

/* 语言分布 */
const langCount = new Map<string, number>();
items.forEach((it) => {
  const key = it.language || '未标注';
  langCount.set(key, (langCount.get(key) ?? 0) + 1);
});
const langs = [...langCount.entries()].sort((a, b) => b[1] - a[1]).slice(0, 10);
const langMax = Math.max(1, ...langs.map((l) => l[1]));
const langTotal = items.length;

/* 单日涨星前列 */
const gainers = items
  .filter((it) => typeof it.starGain === 'number' && it.starGain! > 0)
  .sort((a, b) => (b.starGain ?? 0) - (a.starGain ?? 0))
  .slice(0, 10);

/* 上榜次数 */
const appear = new Map<string, { name: string; times: number; rating: number }>();
issues.forEach((issue) => {
  issue.categories.forEach((c) =>
    c.items.forEach((it) => {
      const cur = appear.get(it.full_name);
      if (cur) cur.times += 1;
      else appear.set(it.full_name, { name: it.full_name, times: 1, rating: it.rating });
    })
  );
});
const regulars = [...appear.values()]
  .filter((r) => r.times > 1)
  .sort((a, b) => b.times - a.times || b.rating - a.rating)
  .slice(0, 10);
---

<Base title="长期观察 · 开源雷达" description="跨期聚合：评分分布、语言分布、单日涨星与常驻榜项目。">
  <header class="hero">
    <p class="hero-top mono"><span>Observation</span><span>{issues.length} 期 · {items.length} 条记录</span></p>
    <h1>长期观察</h1>
    <p class="hero-lede">
      把每一期摊平来看：评分集中在什么区间，哪些语言反复出现，哪些仓库是榜单常客。全部由已归档的数据在构建时聚合，无额外抓取。
    </p>
  </header>

  <section class="panel">
    <h2>每期规模</h2>
    <p>候选数是当日去重后的仓库总量，去重拦截是被 30 天窗口挡下的往期入选项目。</p>
    <div class="archive-list" style="margin-top:18px">
      {
        issues.map((issue) => (
          <a class="archive-item" href={`${base}posts/${issue.date}/`}>
            <time datetime={issue.date}>{issue.date}</time>
            <span>{displayDate(issue.date)}</span>
            <span class="mono small faint">
              候选 {issue.stats.candidates} · 入选 {issue.stats.selected} · 拦截 {issue.stats.suppressedByHistory}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="panel">
    <div class="grid-2">
      <div>
        <h2>评分分布</h2>
        <p>0.5 分制，按热度 45%、社区 25%、活跃 18%、成熟 12% 加权后映射。</p>
        <div class="dist">
          {
            ratingBuckets.map((b) => (
              <div class="dist-row">
                <span class="mono">{b.toFixed(1)} 分</span>
                <span class="dist-track">
                  <i style={`width:${((ratingCount.get(b) ?? 0) / ratingMax) * 100}%`} />
                </span>
                <span class="v">{ratingCount.get(b) ?? 0}</span>
              </div>
            ))
          }
        </div>
      </div>

      <div>
        <h2>语言分布</h2>
        <p>共 {langTotal} 条记录中出现最多的前 {langs.length} 种语言。</p>
        <div class="dist">
          {
            langs.map(([lang, count]) => (
              <div class="dist-row">
                <span class="mono">{lang}</span>
                <span class="dist-track">
                  <i style={`width:${(count / langMax) * 100}%`} />
                </span>
                <span class="v">{count}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="panel">
    <div class="grid-2">
      <div>
        <h2>单日涨星前列</h2>
        <p>取每期快照或 Trending 记录的真实日增，跨期取最高的十条。</p>
        <div style="margin-top:18px">
          {
            gainers.map((it, i) => (
              <a class="rank-row" href={it.url} target="_blank" rel="noopener noreferrer">
                <span class="idx">{String(i + 1).padStart(2, '0')}</span>
                <span>{it.full_name}</span>
                <span class="val">+{num(it.starGain ?? 0)}</span>
              </a>
            ))
          }
          {gainers.length === 0 && <p class="empty"><b>暂无数据</b>首期只有速度估算，累积两天快照后才会出现真实日增。</p>}
        </div>
      </div>

      <div>
        <h2>榜单常客</h2>
        <p>在已归档期次中出现超过一次的项目，按出现次数排序。</p>
        <div style="margin-top:18px">
          {
            regulars.map((r, i) => (
              <div class="rank-row">
                <span class="idx">{String(i + 1).padStart(2, '0')}</span>
                <span>{r.name}</span>
                <span class="val">{r.times} 次 · {r.rating.toFixed(1)}</span>
              </div>
            ))
          }
          {regulars.length === 0 && (
            <p class="empty"><b>还没有重复上榜的项目</b>去重窗口会让同一项目 30 天内不再出现。</p>
          )}
        </div>
      </div>
    </div>
  </section>
</Base>

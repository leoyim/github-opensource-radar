---
import RatingMeter from './RatingMeter.astro';
import MetricBars from './MetricBars.astro';
import Sparkline from './Sparkline.astro';
import { num, heatLabel } from '../lib/format';
import { avatarOf } from '../lib/load';
import type { IssueItem, SeriesPoint } from '../lib/schema';
import type { Interpretation } from '../lib/interpretations';

interface Props {
  item: IssueItem;
  index: number;
  series?: SeriesPoint[];
  interpretation?: Interpretation | null;
}

const { item, index, series = [], interpretation = null } = Astro.props;
const scores = item.roleScores ?? {};
const hasScores = Object.keys(scores).length > 0;
const starValues = series.map((p) => p.stars);

const slug = item.full_name.replace('/', '__');
const avatar = avatarOf(item.owner);
const words = interpretation ? Math.max(100, Math.round(interpretation.chars / 100) * 100) : 0;
const hasActions = Boolean(interpretation) || Boolean(item.breakdown);
---

<article class="repo" id={`repo-${slug}`} data-rank={index} data-scores={JSON.stringify(scores)} data-name={item.full_name}>
  <div class="repo-rank mono">#{index}</div>

  <div class="repo-main">
    <h3 class="repo-title">
      <span class="repo-owner">{item.owner} /</span>
      <a href={item.url} target="_blank" rel="noopener noreferrer">{item.name}</a>
      {item.language && <span class="repo-lang mono">{item.language}</span>}
    </h3>

    {item.description && <p class="repo-desc">{item.description}</p>}

    <div class="repo-meta">
      <span><strong>{num(item.stars)}</strong> stars</span>
      <span><strong>{num(item.forks)}</strong> forks</span>
      {
        item.starGain != null && item.starGain > 0 ? (
          <span class="gain"><strong>+{num(item.starGain)}</strong> / 日</span>
        ) : (
          <span>≈ {item.heat} / 天</span>
        )
      }
      <span>{heatLabel(item.heatBasis)}</span>
      {item.license && <span>{item.license}</span>}
    </div>

    {item.summary_zh && <p class="repo-summary">{item.summary_zh}</p>}
    {item.highlight_zh && <p class="repo-highlight">{item.highlight_zh}</p>}

    {
      item.topics && item.topics.length > 0 && (
        <ul class="repo-topics">
          {item.topics.slice(0, 8).map((t) => (
            <li class="topic">{t}</li>
          ))}
        </ul>
      )
    }

    {
      hasActions && (
        <div class="repo-actions">
          {interpretation && (
            <a class="read-btn" href={`#read-${slug}`} data-read={slug}>
              详细解读
              <span class="read-btn-n mono">约 {words} 字</span>
            </a>
          )}
          <MetricBars breakdown={item.breakdown} />
        </div>
      )
    }
  </div>

  <div class="repo-side">
    <RatingMeter rating={item.rating} />
    {starValues.length >= 2 && <Sparkline values={starValues} label={`${item.full_name} 星标走势`} />}
    {
      hasScores && (
        <div class="rel" aria-hidden="true">
          <div class="rel-bar"><i></i></div>
          <div class="rel-num">0%</div>
        </div>
      )
    }
    <!-- 项目标记：优先用 owner 头像（GitHub 上仓库页显示的就是它），
         地址来自 _data/owners.json 的离线缓存；缓存缺这一项或图挂了，
         就露出底下那层首字母，不会出现破图。 -->
    <span class="avatar" aria-hidden="true">
      <span>{item.owner.slice(0, 1)}</span>
      {
        avatar && (
          <img
            src={avatar}
            alt=""
            width="96"
            height="96"
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
            onerror="this.remove()"
          />
        )
      }
    </span>
  </div>

</article>

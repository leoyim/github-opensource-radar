---
import RatingMeter from './RatingMeter.astro';
import MetricBars from './MetricBars.astro';
import Sparkline from './Sparkline.astro';
import { num } from '../lib/format';
import type { IssueItem, SeriesPoint } from '../lib/schema';
import type { Interpretation } from '../lib/interpretations';

interface Props {
  item: IssueItem;
  index: number;
  series?: SeriesPoint[];
  interpretation?: Interpretation | null;
}

const { item, index, series = [], interpretation = null } = Astro.props;
const scores = item.roleScores ?? {};
const hasScores = Object.keys(scores).length > 0;
const starValues = series.map((p) => p.stars);

const slug = item.full_name.replace('/', '__');
const words = interpretation ? Math.max(100, Math.round(interpretation.chars / 100) * 100) : 0;
---

<!--
  条目卡：左主栏（名称/摘要/标签/评分依据）+ 右数据面板（评分/指标/走势/解读按钮）。
  面板自上而下填满，主栏底部一行收口，不留空档。
  交互钩子（data-scores / .rel / .repo-rank / data-read）原样保留。
-->
<article
  class="repo row"
  id={`repo-${slug}`}
  data-rank={index}
  data-scores={JSON.stringify(scores)}
  data-name={item.full_name}
>
  <span class="row-rank repo-rank mono">{String(index).padStart(2, '0')}</span>

  <div class="row-main">
    <p class="row-owner mono">{item.owner}</p>
    <h3 class="row-name">
      <a href={item.url} target="_blank" rel="noopener noreferrer">{item.name}</a>
      {item.language && <span class="row-lang mono">{item.language}</span>}
    </h3>

    {item.description && <p class="row-desc">{item.description}</p>}
    {item.summary_zh && <p class="row-sum">{item.summary_zh}</p>}
    {item.highlight_zh && <p class="row-hl">{item.highlight_zh}</p>}

    <div class="row-foot">
      {
        item.topics && item.topics.length > 0 && (
          <ul class="row-topics">
            {item.topics.slice(0, 8).map((t) => (
              <li class="topic">{t}</li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

  <div class="row-side">
    <div class="side-score">
      <RatingMeter rating={item.rating} />
      {
        hasScores && (
          <div class="rel" aria-hidden="true">
            <div class="rel-bar"><i></i></div>
            <div class="rel-num">0%</div>
          </div>
        )
      }
    </div>

    <dl class="side-data">
      <div><dt>星标</dt><dd><b>{num(item.stars)}</b> ★</dd></div>
      {
        item.starGain != null && item.starGain > 0 ? (
          <div>
            <dt>热度</dt>
            <dd class="up"><b>+{num(item.starGain)}</b> / 日 · {item.heatBasis === 'snapshot' ? '真实日增' : item.heatBasis === 'trending' ? 'Trending 日增' : '速度估算'}</dd>
          </div>
        ) : (
          <div>
            <dt>热度</dt>
            <dd>≈ {item.heat} / 天 · {item.heatBasis === 'snapshot' ? '真实日增' : item.heatBasis === 'trending' ? 'Trending 日增' : '速度估算'}</dd>
          </div>
        )
      }
      {item.forks ? <div><dt>Forks</dt><dd><b>{num(item.forks)}</b></dd></div> : null}
      {item.license && <div><dt>许可</dt><dd>{item.license}</dd></div>}
    </dl>

    {item.breakdown && (
      <div class="side-breakdown">
        <MetricBars breakdown={item.breakdown} open />
      </div>
    )}

    {
      starValues.length >= 2 && (
        <div class="side-spark">
          <Sparkline values={starValues} label={`${item.full_name} 星标走势`} />
        </div>
      )
    }

    {interpretation && (
      <a class="read" href={`#read-${slug}`} data-read={slug}>
        解读<span class="read-n mono">{words} 字</span>
      </a>
    )}
  </div>
</article>

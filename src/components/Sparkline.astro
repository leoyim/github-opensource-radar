---
import { sparkPoints } from '../lib/format';

interface Props {
  values: number[];
  label?: string;
}

const { values, label = '星标走势' } = Astro.props;
const points = sparkPoints(values);
const first = values[0];
const last = values[values.length - 1];
---

{
  points && (
    <svg class="spark" width="108" height="24" viewBox="0 0 108 24" role="img" aria-label={`${label}：从 ${first} 增至 ${last}`}>
      <polyline points={points} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
      <circle cx={points.split(' ').at(-1)?.split(',')[0]} cy={points.split(' ').at(-1)?.split(',')[1]} r="1.8" fill="currentColor" />
    </svg>
  )
}

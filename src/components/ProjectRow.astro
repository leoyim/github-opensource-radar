---
/**
 * 项目索引里的一行：排名 / 头像 / 名称简介 / 语言 / 星标与涨星 / 评分 / 期次。
 * 语言、涨星、评分各自成列，便于横向比对；data-* 供搜索与三维排序使用。
 */
import { avatarOf } from '../lib/load';
import { num } from '../lib/format';
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
  base: string;
  /** 索引页搜索模式：第 PAGE_SIZE 条之后先隐藏，交给前端过滤 */
  startHidden?: boolean;
}

const { project: p, base, startHidden = false } = Astro.props;
const avatar = avatarOf(p.owner);
const slug = p.full_name.replace('/', '__');
const href = `${base}posts/${p.date}/#repo-${slug}`;
const day = p.date.slice(5);
const gain = typeof p.starGain === 'number' && p.starGain > 0 ? p.starGain : null;
const blurb = p.summary_zh || p.description || '';
const haystack = [
  p.full_name,
  p.owner,
  p.name,
  p.summary_zh || '',
  p.description || '',
  p.language || '',
  p.categoryLabel,
  (p.topics ?? []).join(' '),
]
  .join(' ')
  .toLowerCase();
---

<a
  class="proj"
  id={`proj-${slug}`}
  href={href}
  data-search={haystack}
  data-rating={p.rating}
  data-stars={p.stars}
  data-gain={gain ?? Math.round(p.heat)}
  data-date={p.date}
  hidden={startHidden || undefined}
>
  <span class="proj-no">{String(p.rank).padStart(2, '0')}</span>

  <span class="proj-mark">
    <span>{p.owner.slice(0, 1)}</span>
    {
      avatar && (
        <img
          src={avatar}
          alt=""
          width="68"
          height="68"
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          onerror="this.remove()"
        />
      )
    }
  </span>

  <span class="proj-body">
    <span class="proj-line">
      <span class="proj-name">
        <span class="proj-owner">{p.owner} /</span>
        {p.name}
      </span>
    </span>
    {blurb && <span class="proj-zh">{blurb}</span>}
  </span>

  <span class="proj-metrics">
    <span class="proj-lang">{p.language || '未标注'}</span>

    <span class="proj-nums">
      <b>{num(p.stars)}</b>
      {
        gain ? (
          <em class="proj-gain">+{num(gain)} / 日</em>
        ) : (
          <em>≈ {num(Math.round(p.heat))} / 天</em>
        )
      }
    </span>

    <span class="proj-score">{p.rating.toFixed(1)}</span>

    <span class="proj-tail">
      <span>{day}</span>
      {p.times > 1 && <span class="proj-times">×{p.times}</span>}
    </span>
  </span>
</a>

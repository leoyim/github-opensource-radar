---
import RepoRow from './RepoRow.astro';
import ReaderDialog from './ReaderDialog.astro';
import { seriesFor, displayDate, weekdayOf, neighborsOf } from '../lib/load';
import { almanacOf, jieQiLine } from '../lib/almanac';
import { interpretationOf, observationOf } from '../lib/interpretations';
import { ROLE_LABELS, roleLabel } from '../lib/format';
import type { Issue } from '../lib/schema';

interface Props {
  issue: Issue;
  issueNo: number;
  latest?: boolean;
}

const { issue, issueNo, latest = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const { prev, next } = neighborsOf(issue.date);

/** 章次用汉字数字：一 二 三。超过十期时退化为阿拉伯数字，不做花活 */
const CN_NO = ['一', '二', '三', '四', '五', '六', '七', '八', '九', '十'];

/** 站点自持角色展示名，仅用报告里出现过的角色键，避免与上游配置耦合。
 *  上游 roleScores 里带有 all:100（"不筛选"），这里排除，否则会多出一个空按钮。 */
const roles = [...new Set(issue.categories.flatMap((c) => c.items.flatMap((i) => Object.keys(i.roleScores ?? {}))))]
  .filter((id) => id !== 'all')
  .map((id) => ({ id, label: roleLabel(id) }))
  .sort((a, b) => Object.keys(ROLE_LABELS).indexOf(a.id) - Object.keys(ROLE_LABELS).indexOf(b.id));

const total = issue.stats.selected;
const perCat = Math.max(...issue.categories.map((c) => c.items.length));
/* 方向上限与各方向实际条数并不总是一致：候选不足的方向会少于上限。
   文案必须区分「上限」与「实入选」，否则会出现「每个方向取前 5 个，共 27 个」这类自相矛盾的表述。 */
const catCounts = issue.categories.map((c) => c.items.length);
const uneven = catCounts.some((n) => n !== perCat);
const shortCats = issue.categories.filter((c) => c.items.length < perCat);
/* 阳历用阿拉伯数字，农历用汉字，节气单独一行。全部在构建期算好 */
const almanac = almanacOf(issue.date);
/* 本期观察：上游 index.md 的横向分析，没有就整节省略 */
const observation = observationOf(issue.date);
/* 本期被筛查拦下的条目：只公示「险些入选」的那几个，完整台账在 /removed/ */
const removed = issue.removed ?? [];
const EV_LABEL: Record<string, string> = {
  metadata: '仓库元数据',
  content: 'README 文本',
  correlation: '跨仓库关联',
  manual: '人工复核',
  'public-opinion': '公开讨论',
  'expert-critique': '技术社区评价',
  'issue-reports': 'Issue 反馈',
};
/* 有解读的条目，浮层集中放在条目列表之外渲染 */
const readers = issue.categories
  .flatMap((c) => c.items)
  .flatMap((item) => {
    const doc = interpretationOf(issue.date, item.full_name);
    return doc ? [{ item, doc }] : [];
  });
const baselineNote =
  issue.baseline.heatBasis === 'snapshot' ? '热度取与上一份快照对比的真实日增' : '首期无基线，热度按星标速度估算';const baselineDate = issue.baseline.prevSnapshotDate ? issue.baseline.prevSnapshotDate.slice(5) : '无';

/* ---------- 信号晨报版面用 ---------- */
/* 电讯条：按真实日增取前八条，全零时退回星标数排序 */
const wireItems = [...issue.categories.flatMap((c) => c.items)]
  .sort((a, b) => (b.starGain ?? 0) - (a.starGain ?? 0) || b.stars - a.stars)
  .slice(0, 8);
/* 雷达光点：六个方向按固定坐标落位，count 为真实入选数 */
const BLIP_POS: Array<[number, number, string]> = [
  [31, 25, 'hot'],
  [67, 21, 'left'],
  [72, 53, 'left'],
  [48, 76, ''],
  [23, 61, ''],
  [39, 44, ''],
  [62, 80, 'left'],
  [14, 42, ''],
];
const blips = issue.categories
  .map((c, i) => ({
    label: c.short ?? c.label,
    count: c.items.length,
    x: BLIP_POS[i % BLIP_POS.length][0],
    y: BLIP_POS[i % BLIP_POS.length][1],
    cls: BLIP_POS[i % BLIP_POS.length][2],
  }))
  .slice(0, BLIP_POS.length);
/* 观象台：农历拆月 / 日，方向分布条的百分比上限 */
const lunarParts = almanac.lunarDate.split('月');
const lunarMonth = `${lunarParts[0]}月`;
const lunarDay = lunarParts[1] ?? almanac.lunarDate;
const maxCat = Math.max(...catCounts, 1);
const issueNoPad = String(issueNo).padStart(3, '0');
const dateShort = issue.date.slice(5).replace('-', '.');
---

<article class="issue">
  <div class="wire" aria-label="今日电讯">
    <span class="wire-label">电讯</span>
    <div class="wire-track">
      <div class="wire-set">
        {wireItems.map((it) => (
          <span class="wire-item">
            <b>{it.name}</b>
            {it.starGain != null && it.starGain > 0 ? <em>+{it.starGain}</em> : <em>—</em>}
            <span>{it.stars} ★</span>
          </span>
        ))}
        <span class="wire-item">
          <b>入选 {total}</b>
          <span>候选 {issue.stats.candidates}</span>
        </span>
      </div>
      <div class="wire-set" aria-hidden="true">
        {wireItems.map((it) => (
          <span class="wire-item">
            <b>{it.name}</b>
            {it.starGain != null && it.starGain > 0 ? <em>+{it.starGain}</em> : <em>—</em>}
            <span>{it.stars} ★</span>
          </span>
        ))}
        <span class="wire-item">
          <b>入选 {total}</b>
          <span>候选 {issue.stats.candidates}</span>
        </span>
      </div>
    </div>
  </div>

  <header class="front" aria-labelledby="cover-title">
    <div class="fc-rail" aria-label="期号与日期">
      <div class="rail-bottom">
        <div class="rail-block">
          <span>ISSUE</span>
          <strong>{issueNoPad}</strong>
          <small>
            {almanac.ganzhiYear}年 · {almanac.lunarDate}
          </small>
        </div>
        <div class="rail-block">
          <span>DATE</span>
          <strong>{dateShort}</strong>
          <small>
            {issue.date} / {weekdayOf(issue.date)}
          </small>
        </div>
        <div class="rail-block total">
          <span>基线</span>
          <strong>{baselineDate}</strong>
          <small>对比基线</small>
        </div>
      </div>
    </div>

    <div class="hero">
      <p class="kicker">
        <span class="seal-chip" aria-hidden="true">雷达</span>
        <span>GitHub 热点日报 · 第 {issueNoPad} 期</span>
      </p>
      <h1 id="cover-title">
        <time datetime={issue.date}>{displayDate(issue.date)}</time>
      </h1>
      <p class="dek">
        从 {issue.stats.candidates} 个候选仓库中按四项指标加权，每个方向上限 {perCat}
        个{uneven ? `（${shortCats.map((c) => `${c.label} ${c.items.length} 个`).join('、')}候选不足）` : ''}，共 {total} 个项目，附中文精读摘要。
      </p>
      <div class="hero-stats" aria-label="本期数据">
        <div class="stat"><b>{issue.stats.candidates}</b><span>候选</span></div>
        <div class="stat"><b>{total}</b><span>入选</span></div>
        <div class="stat"><b>{issue.categories.length}</b><span>覆盖方向</span></div>
        <div class="stat"><b>{issue.stats.suppressedByHistory}</b><span>去重拦截</span></div>
      </div>
    </div>

    <div class="radar" role="img" aria-label={`今日 ${total} 条信号在 ${issue.categories.length} 个方向上的分布`}>
      <div class="radar-top">
        <span><b>SIGNAL MAP</b> / 今日分布</span>
        <span class="live">LIVE</span>
      </div>
      <div class="scope" aria-hidden="true">
        <div class="sweep"></div>
        <div class="scope-center"></div>
        {blips.map((b) => (
          <span class:list={['blip', b.cls]} style={`left:${b.x}%;top:${b.y}%`}>
            <b>{b.label}</b> {b.count}
          </span>
        ))}
      </div>
      <div class="radar-bottom">
        <span><b>{total}</b> SIGNALS / {issue.categories.length} BANDS</span>
        <span>SCAN {issue.date.replaceAll('-', ' ')}</span>
      </div>
    </div>
  </header>

  <div class="controls">
    <div class="wrap">
      <div class="controls-inner" id="controls-scroller">
        <span class="ctrl-label">视角</span>
        <button class="chip" data-role-btn="all" aria-pressed="true">全部</button>
        {
          roles.map((r) => (
            <button class="chip" data-role-btn={r.id} aria-pressed="false">
              {r.label}
            </button>
          ))
        }
        <span class="divider-v" aria-hidden="true"></span>
        <span class="ctrl-label">方向</span>
        <button class="chip" data-cat-btn="all" aria-pressed="true">全部</button>
        {
          issue.categories.map((c) => (
            <button class="chip" data-cat-btn={c.id} aria-pressed="false">
              {c.label}
            </button>
          ))
        }
      </div>
      <button
        class="ctrl-nav is-prev"
        type="button"
        data-ctrl-nav="prev"
        aria-label="往前看更多筛选项"
        aria-controls="controls-scroller"
      >
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path
            d="M10 3.5 5.5 8l4.5 4.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="square"></path>
        </svg>
      </button>
      <button
        class="ctrl-nav is-next"
        type="button"
        data-ctrl-nav="next"
        aria-label="往后看更多筛选项"
        aria-controls="controls-scroller"
      >
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path
            d="M6 3.5 10.5 8 6 12.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="square"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="board">
    <div class="content issue-body">
      {
        issue.categories.map((cat, ci) => (
          <section class="cat" id={`cat-${cat.id}`} data-cat={cat.id}>
            <div class="sec-head">
              <span class="sec-no mono" aria-hidden="true">
                {CN_NO[ci] ?? String(ci + 1)}
              </span>
              <h2>{cat.label}</h2>
              <span class="spacer"></span>
              <span class="note mono">
                {cat.items.length} / 上限 {perCat}
              </span>
            </div>
            {cat.desc && <p class="cat-desc">{cat.desc}</p>}
            {cat.items.length === 0 ? (
              <p class="empty">
                <b>本期该方向无新增</b>
                候选项目均已被近 30 天推送覆盖，或数量不足。
              </p>
            ) : (
              <div class="repo-list">
                {cat.items.map((item, i) => (
                  <RepoRow
                    item={item}
                    index={i + 1}
                    series={seriesFor(item.full_name)}
                    interpretation={interpretationOf(issue.date, item.full_name)}
                  />
                ))}
              </div>
            )}
          </section>
        ))
      }
    </div>

    <aside class="aside" aria-label="观象台">
      <section class="panel">
        <h3>观象 · ALMANAC</h3>
        <div class="almanac-top">
          <div class="lunar-day">{lunarDay}</div>
          <div class="lunar-meta">
            <b>
              {almanac.ganzhiYear}年 {lunarMonth}
            </b>
            {issue.date}
            <br />
            {weekdayOf(issue.date)}
          </div>
        </div>
        <div class="yiji">
          <div><i>节气</i><span class={almanac.jieQi ? 'tag' : undefined}>{jieQiLine(almanac)}</span></div>
          <div><i>热度</i><span>{baselineNote}</span></div>
        </div>
      </section>

      <section class="panel">
        <h3>方向分布 · READOUT</h3>
        <div class="rd-bars">
          {issue.categories.map((c) => (
            <div class="rd-bar">
              <span>{c.label}</span>
              <div class="rd-track"><i style={`--p:${Math.round((c.items.length / maxCat) * 100)}%`}></i></div>
              <b>{c.items.length}</b>
            </div>
          ))}
        </div>
      </section>

      <section class="panel">
        <h3>本期移除 · REMOVED</h3>
        <div class="removed-big">
          <b>{String(removed.length).padStart(2, '0')}</b>
          <span>OUT OF EDITION</span>
        </div>
        <p class="panel-small">
          判定只依据可复核的公开事实，完整台账见
          <a class="more" href={`${base}removed/`}>风险提示 →</a>
        </p>
      </section>

      {latest && (
        <section class="panel">
          <h3>编者按 · NOTE</h3>
          <p class="panel-small">
            本期为最新一期，<a class="more" href="#observation">本期观察 →</a>
          </p>
        </section>
      )}
    </aside>
  </div>

  {
    removed.length > 0 && (
      <section class="removed" id="removed">
        <header class="cat-head rm-head">
          <span class="cat-no" aria-hidden="true">附</span>
          <h2>本期移除</h2>
          <p class="cat-desc">
            筛查在归类之前执行，命中即不进入榜单。判定只依据可复核的公开事实，不对作者动机作推断。
          </p>
        </header>
        <ol class="rm-list">
          {removed.map((e, i) => (
            <li class="rm-item">
              <div class="rm-line">
                <span class="rm-no">{String(i + 1).padStart(2, '0')}</span>
                <a class="rm-name" href={e.url} target="_blank" rel="noopener noreferrer">
                  {e.full_name}
                </a>
                <span class="rm-tag">{e.categoryLabel ?? '风险项'}</span>
                {e.retroactive && <span class="rm-tag is-ghost">回溯勘误</span>}
              </div>
              {e.description && <p class="rm-desc">{e.description}</p>}
              <p class="rm-verdict">{e.verdict}</p>
              <details class="rm-ev">
                <summary>证据链 · {(e.evidence ?? []).length} 项可复核事实</summary>
                <ul>
                  {(e.evidence ?? []).map((ev) => (
                    <li>
                      <span class="rm-ev-type">{EV_LABEL[ev.type] ?? ev.type}</span>
                      <b>{ev.label}</b>
                      {ev.detail}
                    </li>
                  ))}
                </ul>
              </details>
              {e.advice && <p class="rm-advice">建议 · {e.advice}</p>}
            </li>
          ))}
        </ol>
        <p class="rm-foot">
          <a href={`${base}removed/`}>风险提示 · 完整台账 →</a>
        </p>
      </section>
    )
  }

  {readers.map(({ item, doc }) => <ReaderDialog item={item} doc={doc} />)}

  {
    observation && (
      <section class="observation" id="observation">
        <div class="obs-rail">
          <p class="obs-kicker">
            编者按<i>Editor's Note</i>
          </p>
          <h2>本期观察</h2>
          <p class="obs-meta">
            {issue.date}
            <br />
            第 {String(issueNo).padStart(2, '0')} 期 · {total} 个项目
            <br />
            横向对齐之后
          </p>
        </div>
        <div class="obs-body prose" set:html={observation} />
      </section>
    )
  }

  <nav class="pager" aria-label="翻页">
    {
      prev ? (
        <a href={`${base}posts/${prev}/`}>
          <span>上一期</span>
          {displayDate(prev)}
        </a>
      ) : (
        <span />
      )
    }
    {
      next ? (
        <a class="next" href={`${base}posts/${next}/`}>
          <span>下一期</span>
          {displayDate(next)}
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</article>

<script>
  const roleButtons = document.querySelectorAll('[data-role-btn]');
  const catButtons = document.querySelectorAll('[data-cat-btn]');
  const sections = document.querySelectorAll('.cat');

  let currentRole = 'all';
  let currentCat = 'all';

  const parseScores = (row) => {
    try {
      return JSON.parse(row.dataset.scores || '{}');
    } catch {
      return {};
    }
  };

  function applyRole() {
    document.body.dataset.role = currentRole;

    sections.forEach((section) => {
      const list = section.querySelector('.repo-list');
      if (!list) return;
      const rows = Array.from(list.querySelectorAll('.repo'));

      rows.forEach((row) => {
        const rel = row.querySelector('.rel');
        if (!rel) return;
        const value = Math.round(parseScores(row)[currentRole] ?? 0);
        const bar = rel.querySelector('.rel-bar i');
        const label = rel.querySelector('.rel-num');
        if (bar) bar.style.width = `${Math.max(0, Math.min(100, value))}%`;
        if (label) label.textContent = `${value}%`;
      });

      rows.sort((a, b) => {
        if (currentRole === 'all') {
          return Number(a.dataset.rank) - Number(b.dataset.rank);
        }
        return (parseScores(b)[currentRole] ?? 0) - (parseScores(a)[currentRole] ?? 0);
      });

      // 顺序没变就不碰 DOM。appendChild 会先把节点摘下来再插回去，
      // 从项目索引带 #repo-xxx 进来时，这次重排会把浏览器刚做好的锚点定位清掉，
      // 表现就是只跳到期次页顶部、没有落到具体条目。
      const current = Array.from(list.querySelectorAll(':scope > .repo'));
      const unchanged = current.length === rows.length && rows.every((row, i) => current[i] === row);
      if (unchanged) return;

      rows.forEach((row, i) => {
        list.appendChild(row);
        const rank = row.querySelector('.repo-rank');
        if (rank) rank.textContent = `#${i + 1}`;
      });
    });
  }

  function applyCat() {
    sections.forEach((section) => {
      section.hidden = currentCat !== 'all' && section.dataset.cat !== currentCat;
    });
  }

  function syncButtons() {
    roleButtons.forEach((b) =>
      b.setAttribute('aria-pressed', String((b.dataset.roleBtn || 'all') === currentRole))
    );
    catButtons.forEach((b) =>
      b.setAttribute('aria-pressed', String((b.dataset.catBtn || 'all') === currentCat))
    );
  }

  function render() {
    syncButtons();
    applyRole();
    applyCat();
    syncCurrentChip();
  }

  /** 筛选状态写进 URL：可分享、刷新不丢、前进后退可复现 */
  function readUrl() {
    const p = new URLSearchParams(location.search);
    const role = p.get('role');
    const cat = p.get('cat');
    const roleOk = role && Array.from(roleButtons).some((b) => b.dataset.roleBtn === role);
    const catOk = cat && Array.from(catButtons).some((b) => b.dataset.catBtn === cat);
    currentRole = roleOk ? role : 'all';
    currentCat = catOk ? cat : 'all';
  }

  function writeUrl(push) {
    const p = new URLSearchParams();
    if (currentRole !== 'all') p.set('role', currentRole);
    if (currentCat !== 'all') p.set('cat', currentCat);
    const q = p.toString();
    const path = q ? location.pathname + '?' + q : location.pathname;
    // 初始化那次要留住页内锚点（从项目索引跳进来的 #repo-xxx）；
    // 用户自己切换筛选时锚点已经失去意义，顺手丢掉。
    const url = push ? path : path + location.hash;
    history[push ? 'pushState' : 'replaceState'](null, '', url);
  }

  roleButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      currentRole = btn.dataset.roleBtn || 'all';
      render();
      writeUrl(true);
    });
  });

  catButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      currentCat = btn.dataset.catBtn || 'all';
      render();
      writeUrl(true);
      // 选中具体方向后把视口带到该类目，避免内容换了人还停在原处
      if (currentCat !== 'all') {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        document
          .querySelector(`.cat[data-cat="${currentCat}"]`)
          ?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      }
    });
  });

  window.addEventListener('popstate', () => {
    readUrl();
    render();
  });

  /* 「方向」chip 跟随滚动位置：弱高亮表示「你正在看这个方向」，
     不改变筛选，aria-pressed 仍只表示真正的筛选状态 */
  let currentFrame = 0;

  function syncCurrentChip() {
    currentFrame = 0;
    let active = null;
    // 筛选到某个方向时高亮固定为该方向，不再随滚动漂
    if (currentCat !== 'all') {
      active = currentCat;
    } else {
      sections.forEach((s) => {
        // 隐藏区块的 rect 恒为 0，不跳过就会把高亮顶到最后一个类目上
        if (s.hidden) return;
        if (s.getBoundingClientRect().top - 150 <= 0) active = s.dataset.cat;
      });
    }
    catButtons.forEach((b) => {
      const id = b.dataset.catBtn || 'all';
      b.classList.toggle('is-current', id === active);
    });
  }

  window.addEventListener(
    'scroll',
    () => {
      if (!currentFrame) currentFrame = requestAnimationFrame(syncCurrentChip);
    },
    { passive: true }
  );
  window.addEventListener('resize', syncCurrentChip, { passive: true });
  // 刷新后停在半页时，首帧也要把吸顶状态对齐
  syncCurrentChip();

  /* 筛选条的横向滚动提示：内容被截断时在两端渐隐，不出滚动轴。
     状态写在 .controls 上，交给 CSS 决定哪一侧亮起。 */
  const controls = document.querySelector('.controls');
  const controlsInner = controls?.querySelector('.controls-inner');

  function syncControlsHint() {
    if (!controls || !controlsInner) return;
    const max = controlsInner.scrollWidth - controlsInner.clientWidth;
    let next = '';
    // 容得下就整条提示都撤掉
    if (max > 1) {
      const atStart = controlsInner.scrollLeft <= 1;
      const atEnd = controlsInner.scrollLeft >= max - 1;
      next = atStart ? 'right' : atEnd ? 'left' : 'both';
    }
    // 只在真的变了才写，避免滚动时每帧都触发样式重算
    if ((controls.dataset.scroll || '') !== next) {
      if (next) controls.dataset.scroll = next;
      else controls.removeAttribute('data-scroll');
    }
  }

  if (controlsInner) {
    controlsInner.addEventListener('scroll', syncControlsHint, { passive: true });
    // 断点切换、字体加载、滚动条出现都会改变可滚动宽度，需要重算
    window.addEventListener('resize', syncControlsHint, { passive: true });
    window.addEventListener('load', syncControlsHint);
    if (document.fonts) document.fonts.ready.then(syncControlsHint);
    syncControlsHint();

    /* 滚轮直接横滚：不用再按 Shift。
       已经滑到端点就把事件放行，让滚轮继续滚页面，不把用户困在条里。 */
    controlsInner.addEventListener(
      'wheel',
      (e) => {
        // 触控板本来就是横向手势，不插手
        if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
        const max = controlsInner.scrollWidth - controlsInner.clientWidth;
        if (max <= 1) return;
        const step =
          e.deltaMode === 1
            ? e.deltaY * 16
            : e.deltaMode === 2
              ? e.deltaY * controlsInner.clientWidth
              : e.deltaY;
        if (!step) return;
        const atStart = controlsInner.scrollLeft <= 1;
        const atEnd = controlsInner.scrollLeft >= max - 1;
        if ((step > 0 && atEnd) || (step < 0 && atStart)) return;
        e.preventDefault();
        controlsInner.scrollLeft += step;
      },
      { passive: false }
    );

    /* 两端箭头：一次滚过去七成可视宽度，最少 160px */
    const navStep = Math.max(160, Math.round(controlsInner.clientWidth * 0.7));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    controls
      ?.querySelectorAll<HTMLButtonElement>('[data-ctrl-nav]')
      .forEach((btn) => {
        btn.addEventListener('click', () => {
          const dir = btn.dataset.ctrlNav === 'next' ? 1 : -1;
          controlsInner.scrollBy({
            left: dir * navStep,
            behavior: reduceMotion.matches ? 'auto' : 'smooth',
          });
        });
      });
  }

  /* 详细解读：有 JS 时走原生 dialog（焦点锁在层内、ESC 可关、关闭后焦点回到按钮）。
     无 JS 时 dlg 上的 :target 规则接管，链接的 hash 就是开关，正文照样读得到。 */
  document.querySelectorAll<HTMLElement>('[data-read]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const dlg = document.getElementById(`read-${btn.dataset.read}`) as HTMLDialogElement | null;
      if (!dlg || typeof dlg.showModal !== 'function') return;
      e.preventDefault();
      dlg.showModal();
    });
  });

  document.querySelectorAll<HTMLElement>('[data-read-close]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const dlg = btn.closest('dialog') as HTMLDialogElement | null;
      if (!dlg) return;
      e.preventDefault();
      dlg.close();
    });
  });

  /* 点浮层外面关闭。只有落在 dialog 盒子之外才算「外面」，
     免得在正文留白处点击也把窗口关掉。 */
  document.querySelectorAll<HTMLDialogElement>('dialog.reader').forEach((dlg) => {
    dlg.addEventListener('click', (e) => {
      if (e.target !== dlg) return;
      const r = dlg.getBoundingClientRect();
      const inside =
        e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      if (!inside) dlg.close();
    });
  });

  /* 带 #repo-xxx 进来时补一次定位：浏览器的锚点跳转发生在脚本之前，
     只要后面动过 DOM 就可能失效。延后一帧，等首屏重排彻底结束。 */
  function restoreHash() {
    const raw = location.hash.slice(1);
    if (!raw) return;
    let el: HTMLElement | null = null;
    try {
      el = document.getElementById(decodeURIComponent(raw));
    } catch {
      el = document.getElementById(raw);
    }
    el?.scrollIntoView({ block: 'start' });
  }

  readUrl();
  render();
  writeUrl(false);
  requestAnimationFrame(restoreHash);
</script>

---
import RepoRow from './RepoRow.astro';
import { seriesFor, displayDateCn, weekdayOf, neighborsOf } from '../lib/load';
import { ROLE_LABELS, roleLabel } from '../lib/format';
import type { Issue } from '../lib/schema';

interface Props {
  issue: Issue;
  issueNo: number;
  latest?: boolean;
}

const { issue, issueNo, latest = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const { prev, next } = neighborsOf(issue.date);

/** 章次用汉字数字：一 二 三。超过十期时退化为阿拉伯数字，不做花活 */
const CN_NO = ['一', '二', '三', '四', '五', '六', '七', '八', '九', '十'];

/** 站点自持角色展示名，仅用报告里出现过的角色键，避免与上游配置耦合。
 *  上游 roleScores 里带有 all:100（"不筛选"），这里排除，否则会多出一个空按钮。 */
const roles = [...new Set(issue.categories.flatMap((c) => c.items.flatMap((i) => Object.keys(i.roleScores ?? {}))))]
  .filter((id) => id !== 'all')
  .map((id) => ({ id, label: roleLabel(id) }))
  .sort((a, b) => Object.keys(ROLE_LABELS).indexOf(a.id) - Object.keys(ROLE_LABELS).indexOf(b.id));

const total = issue.stats.selected;
const perCat = Math.max(...issue.categories.map((c) => c.items.length));
const baselineNote =
  issue.baseline.heatBasis === 'snapshot' ? '热度取与上一份快照对比的真实日增' : '首期无基线，热度按星标速度估算';
const baselineDate = issue.baseline.prevSnapshotDate ? issue.baseline.prevSnapshotDate.slice(5) : '无';
---

<article class="issue">
  <header class="cover">
    <div class="cover-main">
      <p class="cover-kicker">GitHub 热点日报</p>
      <h1><time datetime={issue.date}>{displayDateCn(issue.date)}</time></h1>
      <p class="cover-lede">
        从 {issue.stats.candidates} 个候选仓库中按四项指标加权，每个方向取前 {perCat}
        个，共 {total} 个项目，附中文精读摘要。
      </p>
    </div>

    <aside class="cover-meta">
      <dl>
        <div><dt>期次</dt><dd>第 {String(issueNo).padStart(2, '0')} 期</dd></div>
        <div><dt>星期</dt><dd>{weekdayOf(issue.date)}</dd></div>
        <div><dt>对比基线</dt><dd>{baselineDate}</dd></div>
        {latest && <div><dt>状态</dt><dd class="tag">最新一期</dd></div>}
      </dl>
    </aside>

    <figure class="cover-table">
      <table>
        <caption class="vh">本期概览</caption>
        <thead>
          <tr>
            <th scope="col">候选</th>
            <th scope="col">入选</th>
            <th scope="col">覆盖方向</th>
            <th scope="col">去重拦截</th>
            <th scope="col">每向上限</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>{issue.stats.candidates}</td>
            <td>{total}</td>
            <td>{issue.categories.length}</td>
            <td>{issue.stats.suppressedByHistory}</td>
            <td>{perCat}</td>
          </tr>
        </tbody>
      </table>
      <figcaption>表 1　本期概览　｜　{baselineNote}</figcaption>
    </figure>
  </header>

  <div class="controls">
    <div class="wrap">
      <div class="controls-inner" id="controls-scroller">
        <span class="ctrl-label">视角</span>
        <button class="chip" data-role-btn="all" aria-pressed="true">全部</button>
        {
          roles.map((r) => (
            <button class="chip" data-role-btn={r.id} aria-pressed="false">
              {r.label}
            </button>
          ))
        }
        <span class="divider-v" aria-hidden="true"></span>
        <span class="ctrl-label">方向</span>
        <button class="chip" data-cat-btn="all" aria-pressed="true">全部</button>
        {
          issue.categories.map((c) => (
            <button class="chip" data-cat-btn={c.id} aria-pressed="false">
              {c.label}
            </button>
          ))
        }
      </div>
      <button
        class="ctrl-nav is-prev"
        type="button"
        data-ctrl-nav="prev"
        aria-label="往前看更多筛选项"
        aria-controls="controls-scroller"
      >
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path
            d="M10 3.5 5.5 8l4.5 4.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="square"></path>
        </svg>
      </button>
      <button
        class="ctrl-nav is-next"
        type="button"
        data-ctrl-nav="next"
        aria-label="往后看更多筛选项"
        aria-controls="controls-scroller"
      >
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path
            d="M6 3.5 10.5 8 6 12.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="square"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="issue-body">
    {
      issue.categories.map((cat, ci) => (
        <section class="cat" id={`cat-${cat.id}`} data-cat={cat.id}>
          <header class="cat-head">
            <span class="cat-no" aria-hidden="true">{CN_NO[ci] ?? String(ci + 1)}</span>
            <h2>{cat.label}</h2>
            <p class="cat-desc">{cat.desc}</p>
          </header>
          {cat.items.length === 0 ? (
            <p class="empty">
              <b>本期该方向无新增</b>
              候选项目均已被近 30 天推送覆盖，或数量不足。
            </p>
          ) : (
            <div class="repo-list">
              {cat.items.map((item, i) => (
                <RepoRow item={item} index={i + 1} series={seriesFor(item.full_name)} />
              ))}
            </div>
          )}
        </section>
      ))
    }
  </div>

  <nav class="pager" aria-label="翻页">
    {
      prev ? (
        <a href={`${base}posts/${prev}/`}>
          <span>上一期</span>
          {displayDateCn(prev)}
        </a>
      ) : (
        <span />
      )
    }
    {
      next ? (
        <a class="next" href={`${base}posts/${next}/`}>
          <span>下一期</span>
          {displayDateCn(next)}
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</article>

<script>
  const roleButtons = document.querySelectorAll('[data-role-btn]');
  const catButtons = document.querySelectorAll('[data-cat-btn]');
  const sections = document.querySelectorAll('.cat');

  let currentRole = 'all';
  let currentCat = 'all';

  const parseScores = (row) => {
    try {
      return JSON.parse(row.dataset.scores || '{}');
    } catch {
      return {};
    }
  };

  function applyRole() {
    document.body.dataset.role = currentRole;

    sections.forEach((section) => {
      const list = section.querySelector('.repo-list');
      if (!list) return;
      const rows = Array.from(list.querySelectorAll('.repo'));

      rows.forEach((row) => {
        const rel = row.querySelector('.rel');
        if (!rel) return;
        const value = Math.round(parseScores(row)[currentRole] ?? 0);
        const bar = rel.querySelector('.rel-bar i');
        const label = rel.querySelector('.rel-num');
        if (bar) bar.style.width = `${Math.max(0, Math.min(100, value))}%`;
        if (label) label.textContent = `${value}%`;
      });

      rows.sort((a, b) => {
        if (currentRole === 'all') {
          return Number(a.dataset.rank) - Number(b.dataset.rank);
        }
        return (parseScores(b)[currentRole] ?? 0) - (parseScores(a)[currentRole] ?? 0);
      });

      rows.forEach((row, i) => {
        list.appendChild(row);
        const rank = row.querySelector('.repo-rank');
        if (rank) rank.textContent = `#${i + 1}`;
      });
    });
  }

  function applyCat() {
    sections.forEach((section) => {
      section.hidden = currentCat !== 'all' && section.dataset.cat !== currentCat;
    });
  }

  function syncButtons() {
    roleButtons.forEach((b) =>
      b.setAttribute('aria-pressed', String((b.dataset.roleBtn || 'all') === currentRole))
    );
    catButtons.forEach((b) =>
      b.setAttribute('aria-pressed', String((b.dataset.catBtn || 'all') === currentCat))
    );
  }

  function render() {
    syncButtons();
    applyRole();
    applyCat();
    syncCurrentChip();
  }

  /** 筛选状态写进 URL：可分享、刷新不丢、前进后退可复现 */
  function readUrl() {
    const p = new URLSearchParams(location.search);
    const role = p.get('role');
    const cat = p.get('cat');
    const roleOk = role && Array.from(roleButtons).some((b) => b.dataset.roleBtn === role);
    const catOk = cat && Array.from(catButtons).some((b) => b.dataset.catBtn === cat);
    currentRole = roleOk ? role : 'all';
    currentCat = catOk ? cat : 'all';
  }

  function writeUrl(push) {
    const p = new URLSearchParams();
    if (currentRole !== 'all') p.set('role', currentRole);
    if (currentCat !== 'all') p.set('cat', currentCat);
    const q = p.toString();
    const url = q ? location.pathname + '?' + q : location.pathname;
    history[push ? 'pushState' : 'replaceState'](null, '', url);
  }

  roleButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      currentRole = btn.dataset.roleBtn || 'all';
      render();
      writeUrl(true);
    });
  });

  catButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      currentCat = btn.dataset.catBtn || 'all';
      render();
      writeUrl(true);
      // 选中具体方向后把视口带到该类目，避免内容换了人还停在原处
      if (currentCat !== 'all') {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        document
          .querySelector(`.cat[data-cat="${currentCat}"]`)
          ?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      }
    });
  });

  window.addEventListener('popstate', () => {
    readUrl();
    render();
  });

  /* 「方向」chip 跟随滚动位置：弱高亮表示「你正在看这个方向」，
     不改变筛选，aria-pressed 仍只表示真正的筛选状态 */
  let currentFrame = 0;

  function syncCurrentChip() {
    currentFrame = 0;
    let active = null;
    // 筛选到某个方向时高亮固定为该方向，不再随滚动漂
    if (currentCat !== 'all') {
      active = currentCat;
    } else {
      sections.forEach((s) => {
        // 隐藏区块的 rect 恒为 0，不跳过就会把高亮顶到最后一个类目上
        if (s.hidden) return;
        if (s.getBoundingClientRect().top - 150 <= 0) active = s.dataset.cat;
      });
    }
    catButtons.forEach((b) => {
      const id = b.dataset.catBtn || 'all';
      b.classList.toggle('is-current', id === active);
    });
  }

  window.addEventListener(
    'scroll',
    () => {
      if (!currentFrame) currentFrame = requestAnimationFrame(syncCurrentChip);
    },
    { passive: true }
  );
  window.addEventListener('resize', syncCurrentChip, { passive: true });

  /* 筛选条的横向滚动提示：内容被截断时在两端渐隐，不出滚动轴。
     状态写在 .controls 上，交给 CSS 决定哪一侧亮起。 */
  const controls = document.querySelector('.controls');
  const controlsInner = controls?.querySelector('.controls-inner');

  function syncControlsHint() {
    if (!controls || !controlsInner) return;
    const max = controlsInner.scrollWidth - controlsInner.clientWidth;
    let next = '';
    // 容得下就整条提示都撤掉
    if (max > 1) {
      const atStart = controlsInner.scrollLeft <= 1;
      const atEnd = controlsInner.scrollLeft >= max - 1;
      next = atStart ? 'right' : atEnd ? 'left' : 'both';
    }
    // 只在真的变了才写，避免滚动时每帧都触发样式重算
    if ((controls.dataset.scroll || '') !== next) {
      if (next) controls.dataset.scroll = next;
      else controls.removeAttribute('data-scroll');
    }
  }

  if (controlsInner) {
    controlsInner.addEventListener('scroll', syncControlsHint, { passive: true });
    // 断点切换、字体加载、滚动条出现都会改变可滚动宽度，需要重算
    window.addEventListener('resize', syncControlsHint, { passive: true });
    window.addEventListener('load', syncControlsHint);
    if (document.fonts) document.fonts.ready.then(syncControlsHint);
    syncControlsHint();

    /* 滚轮直接横滚：不用再按 Shift。
       已经滑到端点就把事件放行，让滚轮继续滚页面，不把用户困在条里。 */
    controlsInner.addEventListener(
      'wheel',
      (e) => {
        // 触控板本来就是横向手势，不插手
        if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
        const max = controlsInner.scrollWidth - controlsInner.clientWidth;
        if (max <= 1) return;
        const step =
          e.deltaMode === 1
            ? e.deltaY * 16
            : e.deltaMode === 2
              ? e.deltaY * controlsInner.clientWidth
              : e.deltaY;
        if (!step) return;
        const atStart = controlsInner.scrollLeft <= 1;
        const atEnd = controlsInner.scrollLeft >= max - 1;
        if ((step > 0 && atEnd) || (step < 0 && atStart)) return;
        e.preventDefault();
        controlsInner.scrollLeft += step;
      },
      { passive: false }
    );

    /* 两端箭头：一次滚过去七成可视宽度，最少 160px */
    const navStep = Math.max(160, Math.round(controlsInner.clientWidth * 0.7));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    controls
      ?.querySelectorAll<HTMLButtonElement>('[data-ctrl-nav]')
      .forEach((btn) => {
        btn.addEventListener('click', () => {
          const dir = btn.dataset.ctrlNav === 'next' ? 1 : -1;
          controlsInner.scrollBy({
            left: dir * navStep,
            behavior: reduceMotion.matches ? 'auto' : 'smooth',
          });
        });
      });
  }

  readUrl();
  render();
  writeUrl(false);
</script>

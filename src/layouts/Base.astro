---
import SiteNav from '../components/SiteNav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = '每日 GitHub 热点项目精选：按类别归档、0.5 分制评分、中文精读摘要。',
} = Astro.props;

const base = import.meta.env.BASE_URL;

// 反馈直达新建 issue，省去用户自己找仓库入口
const issueNewUrl = 'https://github.com/leoyim/github-opensource-radar/issues/new';

// 只有配置了真实站点地址才输出 canonical / og:url，避免本地构建产出占位域名
const hasRealSite = Boolean(Astro.site) && !/example\.github\.io/.test(Astro.site!.href);
const canonicalUrl = hasRealSite ? new URL(Astro.url.pathname, Astro.site).href : null;

const year = 2026;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f7f2" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t) {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.dataset.theme = t;
          // 配色也要在首屏定好，否则会先闪一下默认青瓷再跳到用户选的那套。
          // id 与 src/lib/palettes.ts 保持一致；非法值回退默认。
          var p = localStorage.getItem('palette') || 'celadon';
          if (!/^(celadon|daiqing|zhusha|feicui|ziqi|moyun)$/.test(p)) p = 'celadon';
          document.documentElement.dataset.palette = p;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <SiteNav />
    <main class="wrap" id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap colophon">
        <div>
          <p class="colophon-name">开源雷达<em>OpenSource Radar</em></p>
          <p>
            数据来源为 GitHub Trending 页面与 Search API。摘要由模型依据仓库 README 撰写，评分规则见每条末尾的「评分依据」。
            热度优先取与上一份快照对比的真实日增，无基线时按星标速度估算。
          </p>
          <p class="disclaimer">
            本站是第三方开源项目的索引与导读，不托管任何项目代码，与所列项目及 GitHub 均无隶属关系。
            条目信息取自公开数据与项目 README，可能存在滞后或误差；外部链接的内容与安全性由目标站点负责，
            是否使用、是否执行其中的命令，请自行判断。
          </p>
          <p class="imprint">
            <a href={issueNewUrl} target="_blank" rel="noopener noreferrer">建议与勘误</a>
            <br />
            © {year} OpenSource Radar
            <br />
            印章字形：开元小篆／全字库
          </p>
        </div>
        <!-- 印章：字形取自《说文》小篆字体轮廓（public/seal.svg，开元小篆／全字库），
             右列「開源」、左列「靁達」，竖读自右向左 -->
        <div class="seal" aria-hidden="true"><span class="seal-art"></span></div>
      </div>
    </footer>
    <button class="to-top" type="button" data-to-top aria-label="回到顶部">↑</button>

    <!-- 外链跳转前的告知：目标站点不在本站控制范围内，风险提示页的链接另加一句 -->
    <dialog class="leave" id="leave-dialog" aria-labelledby="leave-title">
      <div class="leave-inner">
        <p class="leave-kicker">外部链接</p>
        <h2 id="leave-title" data-leave-title>即将离开本站</h2>
        <p class="leave-body">
          目标页面由第三方维护，其内容、代码与安全性不在本站的核查范围内，也不构成背书或担保。是否访问、是否使用，请自行判断。
        </p>
        <p class="leave-foot">继续访问即表示你已知悉上述情况。</p>
        <div class="leave-actions">
          <button class="leave-stay" type="button" data-leave-stay autofocus>留在本站</button>
          <button class="leave-go" type="button" data-leave-go>继续前往</button>
        </div>
      </div>
    </dialog>

    <script is:inline>
      // 地址栏颜色取当前主题的纸色：换配色与换明暗都走这一处，不再硬编码两个色值
      function syncMeta() {
        var meta = document.querySelector('meta[name="theme-color"]');
        if (!meta) return;
        var bg = getComputedStyle(document.documentElement).getPropertyValue('--color-bg').trim();
        if (bg) meta.setAttribute('content', bg);
      }

      // 墨印刻的是「点了会到的那一段时间」：月入夜读，日回白昼
      function syncThemeButton(mode) {
        var btn = document.querySelector('[data-theme-toggle]');
        if (btn) {
          btn.textContent = mode === 'dark' ? '日' : '月';
          btn.setAttribute('aria-label', mode === 'dark' ? '切换到白昼' : '切换到夜读');
          btn.title = mode === 'dark' ? '白昼' : '夜读';
        }
        syncMeta();
      }
      document.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-theme-toggle]');
        if (!btn) return;
        var root = document.documentElement;
        var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (err) {}
        syncThemeButton(next);
      });
      syncThemeButton(document.documentElement.dataset.theme || 'light');

      // 回到顶部：滚动超过一屏才出现
      (function () {
        var top = document.querySelector('[data-to-top]');
        if (!top) return;
        var toggle = function () {
          top.classList.toggle('show', window.scrollY > 700);
        };
        window.addEventListener('scroll', toggle, { passive: true });
        toggle();
        top.addEventListener('click', function () {
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
        });
      })();

      // 雷达外圈 = 页面滚动进度（状态而非动画，减弱动效时仍然保留）
      (function () {
        var ring = document.querySelector('.ring-progress');
        if (!ring) return;
        var frame = 0;
        var update = function () {
          frame = 0;
          var d = document.documentElement;
          var max = d.scrollHeight - d.clientHeight;
          var p = max > 0 ? Math.min(1, Math.max(0, d.scrollTop / max)) : 0;
          ring.setAttribute('stroke-dashoffset', String(100 - p * 100));
        };
        var schedule = function () {
          if (!frame) frame = requestAnimationFrame(update);
        };
        window.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', schedule);
        update();
      })();

      /*
       * 外链跳转前先告知：一次会话内只问一次，免得每点一条都要确认。
       * 按住修饰键（新标签）的点击不拦，那是明确的主动行为。
       */
      (function () {
        var dialog = document.getElementById('leave-dialog');
        if (!dialog || typeof dialog.showModal !== 'function') return;

        var titleEl = dialog.querySelector('[data-leave-title]');
        var pending = null;

        function remembered() {
          try {
            return sessionStorage.getItem('leave-ok') === '1';
          } catch (e) {
            return false;
          }
        }

        function remember() {
          try {
            sessionStorage.setItem('leave-ok', '1');
          } catch (e) {}
        }

        function go() {
          if (!pending) return;
          var href = pending.href;
          var newTab = pending.newTab;
          pending = null;
          if (newTab) {
            var w = window.open(href, '_blank', 'noopener');
            if (w) w.opener = null;
          } else {
            location.href = href;
          }
        }

        document.addEventListener('click', function (e) {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          var a = e.target.closest('a[href]');
          if (!a) return;

          var url;
          try {
            url = new URL(a.getAttribute('href'), location.href);
          } catch (err) {
            return;
          }
          if (url.protocol !== 'http:' && url.protocol !== 'https:') return;
          if (url.origin === location.origin) return;
          if (remembered()) return;

          e.preventDefault();
          pending = { href: url.href, newTab: a.target === '_blank' };
          var host = url.hostname.replace(/^www\./, '');
          titleEl.textContent = host === 'github.com' ? '即将前往 GitHub' : '即将离开本站';
          dialog.showModal();
        });

        dialog.addEventListener('click', function (e) {
          if (e.target.closest('[data-leave-go]')) {
            remember();
            dialog.close();
            go();
            return;
          }
          if (e.target.closest('[data-leave-stay]')) {
            pending = null;
            dialog.close();
            return;
          }
          // 点遮罩即取消，和按 Esc 一致
          if (e.target === dialog) {
            pending = null;
            dialog.close();
          }
        });

        dialog.addEventListener('cancel', function () {
          pending = null;
        });
      })();

      /* 六套中国风配色：只改 <html data-palette>，色值全部由 CSS token 决定 */
      (function () {
        var root = document.documentElement;
        var picker = document.querySelector('[data-palette-picker]');
        var current = document.querySelector('[data-palette-current]');
        var options = document.querySelectorAll('[data-palette-option]');

        function sync() {
          var id = root.dataset.palette || 'celadon';
          options.forEach(function (btn) {
            var on = btn.getAttribute('data-palette-option') === id;
            btn.classList.toggle('is-current', on);
            btn.setAttribute('aria-pressed', on ? 'true' : 'false');
            if (!on) return;
            var short = btn.getAttribute('data-palette-short') || '瓷';
            var name = btn.getAttribute('data-palette-name') || short;
            if (current) current.textContent = short;
            // 常驻小扇与扇面朱印跟着当前骨走
            var idx = Number(btn.getAttribute('data-palette-index')) || 0;
            if (picker) {
              picker.querySelectorAll('[data-mini-bone]').forEach(function (el) {
                el.classList.toggle('is-on', Number(el.getAttribute('data-mini-bone')) === idx);
              });
              var seal = picker.querySelector('[data-fan-seal]');
              if (seal) seal.textContent = short;
            }
            var trigger = picker && picker.querySelector('summary');
            if (trigger) {
              trigger.title = '折扇 · 当前' + name;
              trigger.setAttribute('aria-label', '折扇，当前' + name + '，展开十八骨换配色');
            }
          });
          syncMeta();
        }

        // 全屏扇子打开时锁住页面滚动，收扇后还原；焦点落到当前那根骨
        function lockScroll(on) {
          document.documentElement.style.overflow = on ? 'hidden' : '';
          document.body.style.overflow = on ? 'hidden' : '';
        }
        if (picker) {
          picker.addEventListener('toggle', function () {
            lockScroll(picker.open);
            var plate = picker.querySelector('.fan-plate');
            if (!picker.open) {
              if (plate) plate.classList.remove('is-unfolding');
              return;
            }
            // 收扇时卸掉，展开时重挂：<details> 收起并不销毁内容，不这样动画只会播一次
            if (plate) {
              plate.classList.remove('is-unfolding');
              void plate.offsetWidth;
              plate.classList.add('is-unfolding');
            }
            var cur = picker.querySelector('.fan-bone.is-current');
            if (cur) cur.focus({ preventScroll: true });
          });
        }

        /* 开扇音：一声很轻的纸面掠过 ＋ 骨节轻碰，全部由 Web Audio 现场合成，不加载音频文件 */
        var SFX = (function () {
          var AC = window.AudioContext || window.webkitAudioContext;
          var ctx = null;
          var off = false;
          try {
            off = localStorage.getItem('fan-sound') === 'off';
          } catch (err) {}

          function noise(seconds) {
            var len = Math.max(1, Math.floor(ctx.sampleRate * seconds));
            var buf = ctx.createBuffer(1, len, ctx.sampleRate);
            var data = buf.getChannelData(0);
            for (var i = 0; i < len; i++) data[i] = Math.random() * 2 - 1;
            return buf;
          }

          function unfold() {
            if (off || !AC) return;
            if (!ctx) {
              try {
                ctx = new AC();
              } catch (err) {
                return;
              }
            }
            if (ctx.state === 'suspended') ctx.resume();
            var t = ctx.currentTime + 0.02;

            // 纸面掠过：带通扫频的噪声，先亮后暗
            var paper = ctx.createBufferSource();
            paper.buffer = noise(0.8);
            var bp = ctx.createBiquadFilter();
            bp.type = 'bandpass';
            bp.Q.value = 1.2;
            bp.frequency.setValueAtTime(560, t);
            bp.frequency.exponentialRampToValueAtTime(2300, t + 0.3);
            bp.frequency.exponentialRampToValueAtTime(1200, t + 0.58);
            var pg = ctx.createGain();
            pg.gain.setValueAtTime(0.0001, t);
            pg.gain.exponentialRampToValueAtTime(0.06, t + 0.15);
            pg.gain.exponentialRampToValueAtTime(0.0001, t + 0.6);
            paper.connect(bp);
            bp.connect(pg);
            pg.connect(ctx.destination);
            paper.start(t);
            paper.stop(t + 0.66);

            // 骨节轻轻一碰
            var clack = ctx.createBufferSource();
            clack.buffer = noise(0.12);
            var lp = ctx.createBiquadFilter();
            lp.type = 'lowpass';
            lp.frequency.value = 460;
            var cg = ctx.createGain();
            cg.gain.setValueAtTime(0.0001, t + 0.44);
            cg.gain.exponentialRampToValueAtTime(0.045, t + 0.47);
            cg.gain.exponentialRampToValueAtTime(0.0001, t + 0.56);
            clack.connect(lp);
            lp.connect(cg);
            cg.connect(ctx.destination);
            clack.start(t + 0.44);
            clack.stop(t + 0.58);
          }

          /* 合扇音：开扇声的倒向——纸面由亮转暗，收到底轻轻一记 */
          function fold() {
            if (off || !AC) return;
            if (!ctx) {
              try {
                ctx = new AC();
              } catch (err) {
                return;
              }
            }
            if (ctx.state === 'suspended') ctx.resume();
            var t = ctx.currentTime + 0.02;

            // 纸面收拢：带通扫频的噪声，由亮转暗
            var paper = ctx.createBufferSource();
            paper.buffer = noise(1.1);
            var bp = ctx.createBiquadFilter();
            bp.type = 'bandpass';
            bp.Q.value = 1.1;
            bp.frequency.setValueAtTime(2100, t);
            bp.frequency.exponentialRampToValueAtTime(520, t + 0.86);
            var pg = ctx.createGain();
            pg.gain.setValueAtTime(0.0001, t);
            pg.gain.exponentialRampToValueAtTime(0.055, t + 0.12);
            pg.gain.exponentialRampToValueAtTime(0.0001, t + 0.92);
            paper.connect(bp);
            bp.connect(pg);
            pg.connect(ctx.destination);
            paper.start(t);
            paper.stop(t + 0.98);

            // 收拢到底的一声轻响
            var clack = ctx.createBufferSource();
            clack.buffer = noise(0.16);
            var lp = ctx.createBiquadFilter();
            lp.type = 'lowpass';
            lp.frequency.value = 380;
            var cg = ctx.createGain();
            cg.gain.setValueAtTime(0.0001, t + 0.82);
            cg.gain.exponentialRampToValueAtTime(0.05, t + 0.86);
            cg.gain.exponentialRampToValueAtTime(0.0001, t + 0.99);
            clack.connect(lp);
            lp.connect(cg);
            cg.connect(ctx.destination);
            clack.start(t + 0.82);
            clack.stop(t + 1);
          }

          return {
            unfold: unfold,
            fold: fold,
            isOff: function () {
              return off;
            },
            set: function (next) {
              off = !!next;
              try {
                localStorage.setItem('fan-sound', off ? 'off' : 'on');
              } catch (err) {}
            }
          };
        })();

        /* ---------- 合扇：收扇也要走一遍动效与声音 ---------- */
        var CLOSE_MS = 1050; // 与 CSS 的 is-closing 时长对齐
        var closing = false;
        function beginClose() {
          if (!picker || !picker.open || closing) return;
          closing = true;
          var plate = picker.querySelector('.fan-plate');
          if (plate) {
            plate.classList.remove('is-unfolding');
            plate.classList.remove('is-closing');
            // 强制回流：合扇用的是同一组关键帧，不这样动画会接着旧的时间轴跑
            void plate.offsetWidth;
            plate.classList.add('is-closing');
          }
          // 三维那侧据此把扇子向中轴合拢
          picker.dispatchEvent(new CustomEvent('fan:closing'));
          SFX.fold();
          window.setTimeout(function () {
            closing = false;
            if (plate) plate.classList.remove('is-closing');
            if (picker) {
              picker.open = false;
              var s = picker.querySelector('summary');
              if (s) s.focus();
            }
          }, CLOSE_MS);
        }

        // 音效开关：按在扇子右下角那枚小印上
        var soundBtn = document.querySelector('[data-fan-sound]');
        function paintSound() {
          if (!soundBtn) return;
          var on = !SFX.isOff();
          soundBtn.textContent = on ? '音' : '静';
          soundBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
          var label = on ? '开扇音效：开，点击关闭' : '开扇音效：关，点击打开';
          soundBtn.title = label;
          soundBtn.setAttribute('aria-label', label);
        }
        paintSound();
        if (soundBtn) {
          soundBtn.addEventListener('click', function () {
            SFX.set(!SFX.isOff());
            paintSound();
            if (!SFX.isOff()) SFX.unfold();
          });
        }

        // 真正展开的那一刻发声；收扇走合扇音
        if (picker) {
          var fanTrigger = picker.querySelector('summary');
          if (fanTrigger) {
            fanTrigger.addEventListener('click', function (ev) {
              if (closing) {
                ev.preventDefault();
                return;
              }
              if (picker.open) {
                // 已展开时点图标：也走一遍合扇，不直接消失
                ev.preventDefault();
                beginClose();
                return;
              }
              SFX.unfold();
            });
          }
        }

        document.addEventListener('click', function (e) {
          var btn = e.target.closest('[data-palette-option]');
          if (btn) {
            var id = btn.getAttribute('data-palette-option');
            root.dataset.palette = id;
            try {
              localStorage.setItem('palette', id);
            } catch (err) {}
            beginClose();
            sync();
            return;
          }
          // 点透明底或扇面之外的空白收扇
          if (e.target.closest('[data-fan-backdrop]')) {
            beginClose();
            return;
          }
          if (picker && picker.open && !picker.contains(e.target)) beginClose();
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && picker && picker.open) {
            beginClose();
          }
        });

        sync();
      })();
    </script>
  </body>
</html>

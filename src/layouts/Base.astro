---
import SiteNav from '../components/SiteNav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = '每日 GitHub 热点项目精选：按类别归档、0.5 分制评分、中文精读摘要。',
} = Astro.props;

const base = import.meta.env.BASE_URL;

// 反馈直达新建 issue，省去用户自己找仓库入口
const issueNewUrl = 'https://github.com/leoyim/github-opensource-radar/issues/new';

// 只有配置了真实站点地址才输出 canonical / og:url，避免本地构建产出占位域名
const hasRealSite = Boolean(Astro.site) && !/example\.github\.io/.test(Astro.site!.href);
const canonicalUrl = hasRealSite ? new URL(Astro.url.pathname, Astro.site).href : null;

const year = 2026;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#eeefea" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      (function () {
        var t;
        try {
          t = localStorage.getItem('theme');
          if (!t) {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.dataset.theme = t;
          // 让浏览器 UI（地址栏 / 状态栏）跟随实际主题，而不是系统偏好
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', t === 'dark' ? '#101312' : '#eeefea');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <SiteNav />
    <main class="wrap" id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap colophon">
        <div>
          <p class="colophon-name">开源雷达<em>OpenSource Radar</em></p>
          <p>
            数据来源为 GitHub Trending 页面与 Search API。摘要由模型依据仓库 README 撰写，评分规则见每条末尾的「评分依据」。
            热度优先取与上一份快照对比的真实日增，无基线时按星标速度估算。
          </p>
          <p class="imprint">
            <a href={issueNewUrl} target="_blank" rel="noopener noreferrer">建议与勘误</a>
            <br />
            © {year} OpenSource Radar
          </p>
        </div>
        <!-- 印章：秦篆四字（開源雷達），按传统印式竖排两列、自右向左读：
             右列「開源」，左列「雷達」；字形按小篆笔意描成线，不依赖篆书字体 -->
        <div class="seal" aria-hidden="true">
          <svg viewBox="0 0 48 48" role="presentation" focusable="false">
            <g fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
              <!-- 開：右列上 -->
              <g transform="translate(26 2)">
                <path d="M3 4H17M3 4v10.6c0 1.2-.8 2-2 2.2M17 4v10.6c0 1.2.8 2 2 2.2" />
                <path d="M5.8 6.4h2.8M7.2 6.4v10.4M11.4 6.4h2.8M12.8 6.4v10.4" />
              </g>
              <!-- 源：右列下 -->
              <g transform="translate(26 26)">
                <path d="M4.9 3.6c-1.2 1-1.2 2.2-.2 2.8M4.3 8.2c-1.2 1-1.2 2.2-.2 2.8M4.9 12.8c-1.2 1-1.2 2.2-.2 2.8" />
                <path d="M17.2 3.6H7.2c-.6 4.8-1.2 9.6-2 13.8" />
                <path d="M9.6 6.2h5.2v3.6H9.6zM11.1 7.5h2.2" />
                <path d="M12 10.4v6.4M9.8 11.6c-.5 1.6-.7 3.4-.7 4.6M14.4 11.6c.5 1.6.7 3.4.7 4.6" />
              </g>
              <!-- 雷：左列上（雨 下 畾，三田品字，《说文》从雨畾象回转形） -->
              <g transform="translate(2 2)">
                <path d="M3 2.6H17M4.5 3v3.4M15.5 3v3.4M10 2.6v4.6M7.2 3.6c-.3 1.2-.3 2.2 0 3.2M12.8 3.6c.3 1.2.3 2.2 0 3.2" />
                <path d="M7 8h6v3.8H7zM10 8v3.8M7 9.9h6" />
                <path d="M3.6 12.6h5.6v4.2H3.6zM6.4 12.6v4.2M3.6 14.7h5.6M10.8 12.6h5.6v4.2h-5.6zM13.6 12.6v4.2M10.8 14.7h5.6" />
              </g>
              <!-- 達：左列下（辶 托 羍，羊 下 大） -->
              <g transform="translate(2 26)">
                <path d="M3.2 4.6c1.2-.7 2-.5 2.6.1M2.8 7.4c1.2-.7 2-.5 2.6.1" />
                <path d="M4.8 10.6c-1.8 2.2-1.4 5 .9 6.3 2.2 1.2 6.2 1.2 11.9 1.1" />
                <path d="M8.6 4.9c.7-1.6 2-1.6 2.7 0M14 4.9c-.7-1.6-2-1.6-2.7 0M8.2 6.4h6.2M11.3 4.6v5.8M8.8 8.6h5" />
                <path d="M6.6 12.4h9.4M11.3 10.6c-.5 2.2-1.1 3.8-1.9 5.2M11.3 10.6c.6 2.2 1.3 3.8 2.3 5.2" />
              </g>
            </g>
          </svg>
        </div>
      </div>
    </footer>
    <button class="to-top" type="button" data-to-top aria-label="回到顶部">↑</button>
    <script is:inline>
      // 按钮显示"将要切换到的模式"，而不是当前模式，避免语义歧义
      function syncThemeButton(mode) {
        var btn = document.querySelector('[data-theme-toggle]');
        if (btn) {
          btn.textContent = mode === 'dark' ? '浅' : '深';
          btn.setAttribute('aria-label', mode === 'dark' ? '切换到浅色' : '切换到深色');
        }
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', mode === 'dark' ? '#101312' : '#eeefea');
      }
      document.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-theme-toggle]');
        if (!btn) return;
        var root = document.documentElement;
        var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (err) {}
        syncThemeButton(next);
      });
      syncThemeButton(document.documentElement.dataset.theme || 'light');

      // 回到顶部：滚动超过一屏才出现
      (function () {
        var top = document.querySelector('[data-to-top]');
        if (!top) return;
        var toggle = function () {
          top.classList.toggle('show', window.scrollY > 700);
        };
        window.addEventListener('scroll', toggle, { passive: true });
        toggle();
        top.addEventListener('click', function () {
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
        });
      })();

      // 雷达外圈 = 页面滚动进度（状态而非动画，减弱动效时仍然保留）
      (function () {
        var ring = document.querySelector('.ring-progress');
        if (!ring) return;
        var frame = 0;
        var update = function () {
          frame = 0;
          var d = document.documentElement;
          var max = d.scrollHeight - d.clientHeight;
          var p = max > 0 ? Math.min(1, Math.max(0, d.scrollTop / max)) : 0;
          ring.setAttribute('stroke-dashoffset', String(100 - p * 100));
        };
        var schedule = function () {
          if (!frame) frame = requestAnimationFrame(update);
        };
        window.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', schedule);
        update();
      })();
    </script>
  </body>
</html>

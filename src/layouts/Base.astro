---
import SiteNav from '../components/SiteNav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = '每日 GitHub 热点项目精选：按类别归档、0.5 分制评分、中文精读摘要。',
} = Astro.props;

const base = import.meta.env.BASE_URL;

// 反馈直达新建 issue，省去用户自己找仓库入口
const issueNewUrl = 'https://github.com/leoyim/github-opensource-radar/issues/new';

// 只有配置了真实站点地址才输出 canonical / og:url，避免本地构建产出占位域名
const hasRealSite = Boolean(Astro.site) && !/example\.github\.io/.test(Astro.site!.href);
const canonicalUrl = hasRealSite ? new URL(Astro.url.pathname, Astro.site).href : null;

const year = 2026;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#eeefea" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      (function () {
        var t;
        try {
          t = localStorage.getItem('theme');
          if (!t) {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.dataset.theme = t;
          // 让浏览器 UI（地址栏 / 状态栏）跟随实际主题，而不是系统偏好
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', t === 'dark' ? '#101312' : '#eeefea');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <SiteNav />
    <main class="wrap" id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap colophon">
        <div>
          <p class="colophon-name">开源雷达<em>OpenSource Radar</em></p>
          <p>
            数据来源为 GitHub Trending 页面与 Search API。摘要由模型依据仓库 README 撰写，评分规则见每条末尾的「评分依据」。
            热度优先取与上一份快照对比的真实日增，无基线时按星标速度估算。
          </p>
          <p class="disclaimer">
            本站是第三方开源项目的索引与导读，不托管任何项目代码，与所列项目及 GitHub 均无隶属关系。
            条目信息取自公开数据与项目 README，可能存在滞后或误差；外部链接的内容与安全性由目标站点负责，
            是否使用、是否执行其中的命令，请自行判断。
          </p>
          <p class="imprint">
            <a href={issueNewUrl} target="_blank" rel="noopener noreferrer">建议与勘误</a>
            <br />
            © {year} OpenSource Radar
            <br />
            印章字形：开元小篆／全字库
          </p>
        </div>
        <!-- 印章：字形取自《说文》小篆字体轮廓（public/seal.svg，开元小篆／全字库），
             右列「開源」、左列「靁達」，竖读自右向左 -->
        <div class="seal" aria-hidden="true"><span class="seal-art"></span></div>
      </div>
    </footer>
    <button class="to-top" type="button" data-to-top aria-label="回到顶部">↑</button>

    <!-- 外链跳转前的告知：目标站点不在本站控制范围内，风险提示页的链接另加一句 -->
    <dialog class="leave" id="leave-dialog" aria-labelledby="leave-title">
      <div class="leave-inner">
        <p class="leave-kicker">外部链接</p>
        <h2 id="leave-title" data-leave-title>即将离开本站</h2>
        <p class="leave-body">
          目标页面由第三方维护，其内容、代码与安全性不在本站的核查范围内，也不构成背书或担保。是否访问、是否使用，请自行判断。
        </p>
        <p class="leave-foot">继续访问即表示你已知悉上述情况。</p>
        <div class="leave-actions">
          <button class="leave-stay" type="button" data-leave-stay autofocus>留在本站</button>
          <button class="leave-go" type="button" data-leave-go>继续前往</button>
        </div>
      </div>
    </dialog>

    <script is:inline>
      // 按钮显示"将要切换到的模式"，而不是当前模式，避免语义歧义
      function syncThemeButton(mode) {
        var btn = document.querySelector('[data-theme-toggle]');
        if (btn) {
          btn.textContent = mode === 'dark' ? '浅' : '深';
          btn.setAttribute('aria-label', mode === 'dark' ? '切换到浅色' : '切换到深色');
        }
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', mode === 'dark' ? '#101312' : '#eeefea');
      }
      document.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-theme-toggle]');
        if (!btn) return;
        var root = document.documentElement;
        var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (err) {}
        syncThemeButton(next);
      });
      syncThemeButton(document.documentElement.dataset.theme || 'light');

      // 回到顶部：滚动超过一屏才出现
      (function () {
        var top = document.querySelector('[data-to-top]');
        if (!top) return;
        var toggle = function () {
          top.classList.toggle('show', window.scrollY > 700);
        };
        window.addEventListener('scroll', toggle, { passive: true });
        toggle();
        top.addEventListener('click', function () {
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
        });
      })();

      // 雷达外圈 = 页面滚动进度（状态而非动画，减弱动效时仍然保留）
      (function () {
        var ring = document.querySelector('.ring-progress');
        if (!ring) return;
        var frame = 0;
        var update = function () {
          frame = 0;
          var d = document.documentElement;
          var max = d.scrollHeight - d.clientHeight;
          var p = max > 0 ? Math.min(1, Math.max(0, d.scrollTop / max)) : 0;
          ring.setAttribute('stroke-dashoffset', String(100 - p * 100));
        };
        var schedule = function () {
          if (!frame) frame = requestAnimationFrame(update);
        };
        window.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', schedule);
        update();
      })();

      /*
       * 外链跳转前先告知：一次会话内只问一次，免得每点一条都要确认。
       * 按住修饰键（新标签）的点击不拦，那是明确的主动行为。
       */
      (function () {
        var dialog = document.getElementById('leave-dialog');
        if (!dialog || typeof dialog.showModal !== 'function') return;

        var titleEl = dialog.querySelector('[data-leave-title]');
        var pending = null;

        function remembered() {
          try {
            return sessionStorage.getItem('leave-ok') === '1';
          } catch (e) {
            return false;
          }
        }

        function remember() {
          try {
            sessionStorage.setItem('leave-ok', '1');
          } catch (e) {}
        }

        function go() {
          if (!pending) return;
          var href = pending.href;
          var newTab = pending.newTab;
          pending = null;
          if (newTab) {
            var w = window.open(href, '_blank', 'noopener');
            if (w) w.opener = null;
          } else {
            location.href = href;
          }
        }

        document.addEventListener('click', function (e) {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          var a = e.target.closest('a[href]');
          if (!a) return;

          var url;
          try {
            url = new URL(a.getAttribute('href'), location.href);
          } catch (err) {
            return;
          }
          if (url.protocol !== 'http:' && url.protocol !== 'https:') return;
          if (url.origin === location.origin) return;
          if (remembered()) return;

          e.preventDefault();
          pending = { href: url.href, newTab: a.target === '_blank' };
          var host = url.hostname.replace(/^www\./, '');
          titleEl.textContent = host === 'github.com' ? '即将前往 GitHub' : '即将离开本站';
          dialog.showModal();
        });

        dialog.addEventListener('click', function (e) {
          if (e.target.closest('[data-leave-go]')) {
            remember();
            dialog.close();
            go();
            return;
          }
          if (e.target.closest('[data-leave-stay]')) {
            pending = null;
            dialog.close();
            return;
          }
          // 点遮罩即取消，和按 Esc 一致
          if (e.target === dialog) {
            pending = null;
            dialog.close();
          }
        });

        dialog.addEventListener('cancel', function () {
          pending = null;
        });
      })();
    </script>
  </body>
</html>

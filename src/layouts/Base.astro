---
import SiteNav from '../components/SiteNav.astro';
import '../styles/global.css';
import { listDates } from '../lib/load';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = '每日 GitHub 热点项目精选：按类别归档、0.5 分制评分、中文精读摘要。',
} = Astro.props;

const base = import.meta.env.BASE_URL;

// 站点起点：数据里最早的一期（listDates 为倒序，取末位）
const sinceDate = listDates().at(-1) ?? '';

// 反馈直达新建 issue，省去用户自己找仓库入口
const issueNewUrl = 'https://github.com/leoyim/github-opensource-radar/issues/new';
const repoUrl = 'https://github.com/leoyim/github-opensource-radar';

// 只有配置了真实站点地址才输出 canonical / og:url，避免本地构建产出占位域名
const hasRealSite = Boolean(Astro.site) && !/example\.github\.io/.test(Astro.site!.href);
const canonicalUrl = hasRealSite ? new URL(Astro.url.pathname, Astro.site).href : null;

const year = 2026;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f7f2" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t) {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.dataset.theme = t;
          // 配色也要在首屏定好，否则会先闪一下默认青瓷再跳到用户选的那套。
          // id 与 src/lib/palettes.ts 保持一致；非法值回退默认。
          var p = localStorage.getItem('palette') || 'celadon';
          if (!/^(celadon|daiqing|zhusha|zhihuang|feicui|ziqi|moyun)$/.test(p)) p = 'celadon';
          document.documentElement.dataset.palette = p;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <SiteNav />
    <main class="wrap" id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap colophon">
        <div>
          <p class="colophon-name">开源雷达<em>OpenSource Radar</em></p>
          <p>
            数据来源为 GitHub Trending 页面与 Search API。摘要由模型依据仓库 README 撰写，评分规则见每条末尾的「评分依据」。
            热度优先取与上一份快照对比的真实日增，无基线时按星标速度估算。
          </p>
          <p class="disclaimer">
            本站是第三方开源项目的索引与导读，不托管任何项目代码，与所列项目及 GitHub 均无隶属关系。
            条目信息取自公开数据与项目 README，可能存在滞后或误差；外部链接的内容与安全性由目标站点负责，
            是否使用、是否执行其中的命令，请自行判断。
          </p>
        </div>
        <!-- 印章：字形取自《说文》小篆字体轮廓（public/seal.svg，开元小篆／全字库），
             右列「開源」、左列「靁達」，竖读自右向左 -->
        <div class="seal" aria-hidden="true"><span class="seal-art"></span></div>
        <!-- 版权行：单行排满整个页脚宽度，含构建/部署/站点起点标识 -->
        <p class="imprint">
          <a href={issueNewUrl} target="_blank" rel="noopener noreferrer">建议与勘误</a>
          <span class="dot" aria-hidden="true">·</span>
          <span>© {year} OpenSource Radar</span>
          <span class="dot" aria-hidden="true">·</span>
          <span>印章字形：开元小篆／全字库</span>
          <span class="dot" aria-hidden="true">·</span>
          <a
            href={`${repoUrl}/actions`}
            target="_blank"
            rel="noopener noreferrer"
            title="每日数据由 GitHub Actions 定时抓取与构建">Built by GitHub Actions</a>
          <span class="dot" aria-hidden="true">·</span>
          <a
            href={`${repoUrl}/deployments`}
            target="_blank"
            rel="noopener noreferrer"
            title="静态产物由 GitHub Pages 发布">Deployed by GitHub Pages</a>
          <span class="dot" aria-hidden="true">·</span>
          <span title="数据里最早的一期，即本站起点">Since {sinceDate}</span>
        </p>
      </div>
    </footer>
    <button class="to-top" type="button" data-to-top aria-label="回到顶部">↑</button>

    <!-- 外链跳转前的告知：目标站点不在本站控制范围内，风险提示页的链接另加一句 -->
    <dialog class="leave" id="leave-dialog" aria-labelledby="leave-title">
      <div class="leave-inner">
        <p class="leave-kicker">外部链接</p>
        <h2 id="leave-title" data-leave-title>即将离开本站</h2>
        <p class="leave-body">
          目标页面由第三方维护，其内容、代码与安全性不在本站的核查范围内，也不构成背书或担保。是否访问、是否使用，请自行判断。
        </p>
        <p class="leave-foot">继续访问即表示你已知悉上述情况。</p>
        <div class="leave-actions">
          <button class="leave-stay" type="button" data-leave-stay autofocus>留在本站</button>
          <button class="leave-go" type="button" data-leave-go>继续前往</button>
        </div>
      </div>
    </dialog>

    <script is:inline>
      // 地址栏颜色取当前主题的纸色：换配色与换明暗都走这一处，不再硬编码两个色值
      function syncMeta() {
        var meta = document.querySelector('meta[name="theme-color"]');
        if (!meta) return;
        var bg = getComputedStyle(document.documentElement).getPropertyValue('--color-bg').trim();
        if (bg) meta.setAttribute('content', bg);
      }

      // 墨印刻的是「点了会到的那一段时间」：月入夜读，日回白昼
      function syncThemeButton(mode) {
        var btn = document.querySelector('[data-theme-toggle]');
        if (btn) {
          btn.textContent = mode === 'dark' ? '日' : '月';
          btn.setAttribute('aria-label', mode === 'dark' ? '切换到白昼' : '切换到夜读');
          btn.title = mode === 'dark' ? '白昼' : '夜读';
        }
        syncMeta();
      }
      document.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-theme-toggle]');
        if (!btn) return;
        var root = document.documentElement;
        var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (err) {}
        syncThemeButton(next);
      });
      syncThemeButton(document.documentElement.dataset.theme || 'light');

      // 回到顶部：滚动超过一屏才出现
      (function () {
        var top = document.querySelector('[data-to-top]');
        if (!top) return;
        var toggle = function () {
          top.classList.toggle('show', window.scrollY > 700);
        };
        window.addEventListener('scroll', toggle, { passive: true });
        toggle();
        top.addEventListener('click', function () {
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
        });
      })();

      // 雷达外圈 = 页面滚动进度（状态而非动画，减弱动效时仍然保留）
      (function () {
        var ring = document.querySelector('.ring-progress');
        if (!ring) return;
        var frame = 0;
        var update = function () {
          frame = 0;
          var d = document.documentElement;
          var max = d.scrollHeight - d.clientHeight;
          var p = max > 0 ? Math.min(1, Math.max(0, d.scrollTop / max)) : 0;
          ring.setAttribute('stroke-dashoffset', String(100 - p * 100));
        };
        var schedule = function () {
          if (!frame) frame = requestAnimationFrame(update);
        };
        window.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', schedule);
        update();
      })();

      /*
       * 外链跳转前先告知：一次会话内只问一次，免得每点一条都要确认。
       * 按住修饰键（新标签）的点击不拦，那是明确的主动行为。
       */
      (function () {
        var dialog = document.getElementById('leave-dialog');
        if (!dialog || typeof dialog.showModal !== 'function') return;

        var titleEl = dialog.querySelector('[data-leave-title]');
        var pending = null;

        function remembered() {
          try {
            return sessionStorage.getItem('leave-ok') === '1';
          } catch (e) {
            return false;
          }
        }

        function remember() {
          try {
            sessionStorage.setItem('leave-ok', '1');
          } catch (e) {}
        }

        function go() {
          if (!pending) return;
          var href = pending.href;
          var newTab = pending.newTab;
          pending = null;
          if (newTab) {
            var w = window.open(href, '_blank', 'noopener');
            if (w) w.opener = null;
          } else {
            location.href = href;
          }
        }

        document.addEventListener('click', function (e) {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          var a = e.target.closest('a[href]');
          if (!a) return;

          var url;
          try {
            url = new URL(a.getAttribute('href'), location.href);
          } catch (err) {
            return;
          }
          if (url.protocol !== 'http:' && url.protocol !== 'https:') return;
          if (url.origin === location.origin) return;
          if (remembered()) return;

          e.preventDefault();
          pending = { href: url.href, newTab: a.target === '_blank' };
          var host = url.hostname.replace(/^www\./, '');
          titleEl.textContent = host === 'github.com' ? '即将前往 GitHub' : '即将离开本站';
          dialog.showModal();
        });

        dialog.addEventListener('click', function (e) {
          if (e.target.closest('[data-leave-go]')) {
            remember();
            dialog.close();
            go();
            return;
          }
          if (e.target.closest('[data-leave-stay]')) {
            pending = null;
            dialog.close();
            return;
          }
          // 点遮罩即取消，和按 Esc 一致
          if (e.target === dialog) {
            pending = null;
            dialog.close();
          }
        });

        dialog.addEventListener('cancel', function () {
          pending = null;
        });
      })();

      /* 六套中国风配色：自绘下拉。只改 <html data-palette>，色值全部由 CSS token 决定 */
      (function () {
        var root = document.documentElement;
        var picker = document.querySelector('[data-palette-picker]');
        if (!picker) return;
        var trigger = picker.querySelector('[data-palette-trigger]');
        var menu = picker.querySelector('[data-palette-menu]');
        var dot = picker.querySelector('[data-palette-dot]');
        var nameEl = picker.querySelector('[data-palette-name]');
        var options = Array.prototype.slice.call(menu.querySelectorAll('[data-palette-option]'));
        var NAME = {};
        options.forEach(function (o) {
          NAME[o.getAttribute('data-palette-option')] = (o.textContent || '').trim();
        });

        function setOpen(on) {
          if (on === picker.classList.contains('is-open')) return;
          picker.classList.toggle('is-open', on);
          trigger.setAttribute('aria-expanded', on ? 'true' : 'false');
          if (on) {
            menu.hidden = false;
            var cur = menu.querySelector('[aria-selected="true"]') || options[0];
            if (cur) cur.focus({ preventScroll: true });
          } else {
            menu.hidden = true;
          }
        }

        function apply(id) {
          if (!NAME[id]) return;
          root.dataset.palette = id;
          try {
            localStorage.setItem('palette', id);
          } catch (err) {}
          sync();
        }

        function sync() {
          var id = root.dataset.palette || 'celadon';
          options.forEach(function (o) {
            var on = o.getAttribute('data-palette-option') === id;
            o.setAttribute('aria-selected', on ? 'true' : 'false');
          });
          var sw = getComputedStyle(menu.querySelector('[data-palette-option="' + id + '"]')).getPropertyValue('--sw').trim();
          if (dot && sw) dot.style.background = sw;
          if (nameEl) nameEl.textContent = NAME[id] || id;
          syncMeta();
        }

        trigger.addEventListener('click', function () {
          setOpen(!picker.classList.contains('is-open'));
        });

        menu.addEventListener('click', function (e) {
          var o = e.target.closest('[data-palette-option]');
          if (!o) return;
          apply(o.getAttribute('data-palette-option'));
          setOpen(false);
          trigger.focus({ preventScroll: true });
        });

        // 方向键在色板间移动，Enter/Space 选中，Esc 收起
        menu.addEventListener('keydown', function (e) {
          var cur = document.activeElement;
          var idx = options.indexOf(cur);
          if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            e.preventDefault();
            var step = e.key === 'ArrowDown' ? 1 : -1;
            options[(idx + step + options.length) % options.length].focus();
          } else if (e.key === 'Home') {
            e.preventDefault();
            options[0].focus();
          } else if (e.key === 'End') {
            e.preventDefault();
            options[options.length - 1].focus();
          } else if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            if (cur && idx >= 0) {
              apply(cur.getAttribute('data-palette-option'));
              setOpen(false);
              trigger.focus({ preventScroll: true });
            }
          } else if (e.key === 'Escape') {
            e.preventDefault();
            setOpen(false);
            trigger.focus({ preventScroll: true });
          }
        });

        // 点外面收起
        document.addEventListener('click', function (e) {
          if (picker.classList.contains('is-open') && !picker.contains(e.target)) setOpen(false);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && picker.classList.contains('is-open')) setOpen(false);
        });

        sync();
      })();
    </script>
  </body>
</html>
